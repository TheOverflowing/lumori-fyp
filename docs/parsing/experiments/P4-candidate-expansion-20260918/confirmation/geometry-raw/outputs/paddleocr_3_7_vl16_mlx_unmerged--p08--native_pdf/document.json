          191.0,
          682.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "第二，欧盟、美国和中国等大型重要市场有可能会通过相互冲突的人工智能监管法规，企业无法——遵循。",
      "block_bbox": [
        192,
        696,
        1027,
        723
      ],
      "block_id": 7,
      "block_order": 7,
      "group_id": 7,
      "block_polygon_points": [
