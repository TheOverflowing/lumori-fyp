      ]
    },
    {
      "block_label": "text",
      "block_content": "监管机构及社会。法规制定机构本身也面临多重挑战，需要有效平衡快速变化的技术发展与一系列利",
      "block_bbox": [
        174,
        341,
        589,
        395
      ],
      "block_id": 2,
      "block_order": 2,
      "group_id": 2,
      "block_polygon_points": [
