    {
      "block_label": "text",
      "block_content": "未来两年，我们可能会见证不同情景的发展。",
      "block_bbox": [
        192,
        585,
        555,
        612
      ],
      "block_id": 5,
      "block_order": 5,
      "group_id": 5,
      "block_polygon_points": [
