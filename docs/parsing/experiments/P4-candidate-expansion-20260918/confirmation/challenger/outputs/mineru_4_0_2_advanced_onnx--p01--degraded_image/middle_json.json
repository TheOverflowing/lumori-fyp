          ]
        },
        {
          "type": "text",
          "index": 30,
          "bbox": [
            0.517,
            0.346,
            0.801,
            0.364
          ],
          "content": [
            {
              "type": "text",
              "content": "plantation a large agricultural estate (p. 416)"
