          ]
        },
        {
          "type": "text",
          "index": 31,
          "bbox": [
            0.517,
            0.364,
            0.819,
            0.379
          ],
          "content": [
            {
              "type": "text",
              "content": "plateau a relatively high, flat land area (p. 225)"
