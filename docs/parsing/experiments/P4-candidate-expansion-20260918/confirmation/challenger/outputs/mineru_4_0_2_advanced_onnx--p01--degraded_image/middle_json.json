        },
        {
          "type": "text",
          "index": 26,
          "bbox": [
            0.512,
            0.236,
            0.885,
            0.272
          ],
          "content": [
            {
              "type": "text",
              "content": "photomontage a picture made of a combination of photographs (p. 774)"
