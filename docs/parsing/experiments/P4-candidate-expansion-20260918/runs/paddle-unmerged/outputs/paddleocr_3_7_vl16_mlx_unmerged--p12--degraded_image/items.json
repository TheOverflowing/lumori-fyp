  {
    "id": 5,
    "type": "paragraph_title",
    "text": "数字化转型进程较快的机构\n更有可能实现成本削减效益",
    "boxes": [
      {
        "page_no": 1,
        "bbox": [
          0.4924712134632418,
          0.110397946084724,
          0.7493356953055802,
