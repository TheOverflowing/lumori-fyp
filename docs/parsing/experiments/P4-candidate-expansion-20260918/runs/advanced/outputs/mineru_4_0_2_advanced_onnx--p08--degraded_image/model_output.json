        ],
        "content": [
          {
            "type": "text",
            "content": "进一步完善单位规章制度，进一步严肃财经纪律。党风廉政建设、文明单位建设等工作扎实推进。"
          }
        ],
        "lines": [
          {
            "bbox": [
              0.093,
