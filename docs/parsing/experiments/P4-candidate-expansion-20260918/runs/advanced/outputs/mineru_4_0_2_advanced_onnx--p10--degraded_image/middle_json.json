          ],
          "content": [
            {
              "type": "text",
              "content": "17. (1) 计算: "
            },
            {
              "type": "equation_inline",
              "content": "(x + 1)(x - 1) + x(2 - x)"
            },
            {
              "type": "text",
              "content": ". (2) 解不等式组: "
            },
            {
              "type": "equation_inline",
              "content": "\\left\\{ \\begin{array}{l} 4x - 3 > 9 \\\\ 2 + x \\geqslant 0 \\end{array} \\right."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.06,
            0.642,
            0.458,
            0.709
          ],
          "content": [
            {
              "type": "text",
              "content": "[答案]:【小问1详解】解: 原式 "
            },
            {
              "type": "equation_inline",
              "content": "= x^{2} - 1 + 2x - x^{2} = 2x - 1"
            },
            {
              "type": "text",
              "content": "; 【小问2详解】解: "
            },
            {
              "type": "equation_inline",
              "content": "\\left\\{ \\begin{array}{l}4x - 3 > 9(1) \\\\ 2 + x \\geqslant 0(2) \\end{array} \\right."
            },
            {
              "type": "text",
              "content": ", 解不等式(1), 得 "
            },
            {
              "type": "equation_inline",
              "content": "x > 3"
            },
            {
              "type": "text",
              "content": ", 解不等式(2), 得 "
            },
            {
              "type": "equation_inline",
              "content": "x \\geqslant -2"
            },
            {
              "type": "text",
              "content": ", 所以原不等式组的解是 "
            },
            {
              "type": "equation_inline",
              "content": "x > 3"
            },
            {
              "type": "text",
              "content": ". [解析]:"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
