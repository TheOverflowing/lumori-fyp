          ],
          "image_path": "images/page_0_equation_0.jpg",
          "content": "\\therefore \\left[ ( 2 b ) 2 + \\left( \\frac { 3 \\sqrt { 2 } } { b } \\right) ^ { 2 } \\right] + \\left[ ( 2 b - b ) 2 + \\left( \\frac { 6 \\sqrt { 2 } } { b } - \\frac { 3 \\sqrt { 2 } } { b } \\right) ^ { 2 } \\right] = b ^ { 2 } + \\left( \\frac { 6 \\sqrt { 2 } } { b } \\right) ^ { 2 } ,"
        },
        {
          "type": "equation",
          "index": 1,
          "bbox": [
            0.103,
            0.153,
            0.14,
            0.171
          ],
          "image_path": "images/page_0_equation_1.jpg",
          "content": "\\therefore b = \\sqrt{3} ,"
        },
        {
          "type": "equation",
          "index": 2,
          "bbox": [
            0.102,
            0.184,
            0.208,
            0.203
          ],
          "image_path": "images/page_0_equation_2.jpg",
          "content": "\\therefore B(\\sqrt{3},2\\sqrt{6}),D(2\\sqrt{3},\\sqrt{6}),"
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.046,
            0.216,
            0.453,
            0.234
          ],
          "content": [
            {
              "type": "text",
              "content": "∵ 直线 𝑂𝐵 的解析式为: "
            },
            {
              "type": "equation_inline",
              "content": "y = 2\\sqrt{2}x, \\therefore"
            },
            {
              "type": "text",
              "content": " 直线 𝐷𝐹 的解析式为: "
            },
            {
              "type": "equation_inline",
              "content": "y = 2 { \\sqrt { 2 } } x { - } 3 { \\sqrt { 6 } } ,"
            },
            {
              "type": "text",
              "content": " 当 "
            },
            {
              "type": "equation_inline",
              "content": "y = 0"
            },
            {
              "type": "text",
              "content": " 时, "
            },
            {
              "type": "equation_inline",
              "content": "2 { \\sqrt { 2 } } x { - } 3 { \\sqrt { 6 } } = 0 ,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 4,
          "bbox": [
            0.2,
            0.244,
            0.246,
            0.276
          ],
          "image_path": "images/page_0_equation_4.jpg",
          "content": "\\therefore x = \\frac{3\\sqrt{3}}{2},"
        },
        {
          "type": "equation",
          "index": 5,
          "bbox": [
            0.2,
            0.281,
            0.261,
            0.322
          ],
          "image_path": "images/page_0_equation_5.jpg",
          "content": "\\therefore F\\left(\\frac{3\\sqrt{3}}{2},0\\right),"
        },
        {
          "type": "equation",
          "index": 6,
          "bbox": [
            0.199,
            0.328,
            0.296,
            0.363
          ],
          "image_path": "images/page_0_equation_6.jpg",
          "content": "\\because OE = \\sqrt{3},OF = \\frac{3\\sqrt{3}}{2},"
        },
        {
          "type": "equation",
          "index": 7,
          "bbox": [
            0.199,
            0.368,
            0.3,
            0.401
          ],
          "image_path": "images/page_0_equation_7.jpg",
          "content": "\\therefore EF = OF - OE = \\frac{\\sqrt{3}}{2},"
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.2,
            0.405,
            0.245,
            0.437
          ],
          "image_path": "images/page_0_equation_8.jpg",
          "content": "\\therefore \\frac{EF}{OE} = \\frac{1}{2},"
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.047,
            0.444,
            0.142,
            0.485
          ],
          "content": [
            {
              "type": "text",
              "content": "故答案为: "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{1}{2},\\left( \\frac{3\\sqrt{3}}{2},0 \\right)"
            }
          ]
        },
        {
          "type": "table",
