  "usage_terms": "Upstream dataset copyright statement: research purposes only, not commercial use. No blanket Apache/CC license for source documents is assumed.",
  "annotation_provenance": "Released OmniDocBench annotations; upstream manual annotation and expert quality review process. No labels were generated or corrected by this project.",
  "selection": "12 source-disjoint PDF groups; 4 prose + 2 complex pages per language. Explicit .pdf_ provenance only, no repeats within or against P1/P3. SHA256 salt p4-confirmation-v1, then fixed eligibility predicates; not selected from parser scores.",
  "variants": {
    "native_pdf": "Official original PDF at older pinned revision, exact page ID matched; not guaranteed born-digital. Original vs benchmark masks/rendering may differ.",
    "page_image": "Unmodified official benchmark page image; not a claim of camera-photo provenance.",
    "image_only_pdf": "Controlled variant: same official image embedded once in a PDF, without text layer.",
    "degraded_image": "Controlled variant: RGB, 65% dimensions Lanczos; +2 degree rotation, expand white canvas, bicubic; JPEG quality55. Simulates some degradation, not a real photo."
  },
  "metric_contract": {
    "text_accuracy_scope": "prose stratum only, to avoid confusing table HTML/formula LaTeX with text OCR errors",
    "cer": "Levenshtein(NFKC(text) with whitespace removed) / normalized GT character count; case and punctuation preserved, raw CER may exceed 1; empty/error prediction has CER=1.",
    "wer": "English prose only; NFKC then Unicode word-or-punctuation tokens, case preserved.",
    "usable_page": "Custom pilot rule fixed before scores: CER<=0.10 and prediction length >=0.80*GT length. Includes all prose failures in denominator; not an industry standard or a semantic correctness guarantee.",
    "structure": "Table/figure/formula gold regions preserved; TEDS, CDM, region recall and image semantic accuracy are NOT computed by this pilot.",
    "aggregation": "Equal-weight macro CER and edit-sum/GT-character-sum micro CER; language and source-page counts reported. Variants are paired observations, not independent new documents."
  },
